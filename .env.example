# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in what you have.
# Anything left blank is handled gracefully: the related button
# is disabled and the related dashboard shows an honest empty state.
#
# VITE_* values are PUBLIC (they ship to the browser). Never put
# secrets in them. Secrets live in the server-only section below.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical / Open Graph). e.g. https://lokesh.vercel.app
VITE_SITE_URL=

# Coding platform usernames (just the handle, not the URL)
VITE_GITHUB_USERNAME=
VITE_LEETCODE_USERNAME=
VITE_HACKERRANK_USERNAME=
VITE_CODEFORCES_HANDLE=

# Full profile / contact links
VITE_LINKEDIN_URL=
VITE_CONTACT_EMAIL=
# Link to your resume PDF, e.g. /resume.pdf (put the file in /public) or a Drive link
VITE_RESUME_URL=

# ── Contact form (choose ONE) ────────────────────────────────
# Option A (easiest): a Formspree endpoint, e.g. https://formspree.io/f/xxxxxxx
VITE_FORMSPREE_ENDPOINT=

# Option B: send through your own Vercel function at /api/contact using Resend.
# These are SERVER-ONLY (no VITE_ prefix). Set them in Vercel → Settings → Environment Variables.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
